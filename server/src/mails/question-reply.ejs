<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Question Reply Notification</title>
    <style>
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 40px 0;
      }

      .email-container {
        max-width: 600px;
        background: #ffffff;
        margin: 0 auto;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
      }

      .header {
        background-color: #2563eb;
        color: #ffffff;
        text-align: center;
        padding: 20px 10px;
      }

      .header h2 {
        margin: 0;
        font-size: 22px;
      }

      .content {
        padding: 30px;
        color: #333333;
        line-height: 1.6;
      }

      .content h3 {
        color: #2563eb;
        margin-bottom: 10px;
      }

      .footer {
        background-color: #f1f5f9;
        text-align: center;
        padding: 15px;
        font-size: 13px;
        color: #6b7280;
      }

      .btn {
        display: inline-block;
        background-color: #2563eb;
        color: white;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 6px;
        margin-top: 20px;
        font-size: 15px;
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <div class="header">
        <h2>Someone replied to your question! 💬</h2>
      </div>

      <div class="content">
        <p>Hi <strong><%= name %></strong>,</p>

        <p>
          Someone has replied to your question in the course:
          <strong><%= title %></strong>.
        </p>

        <p>
          You can view the reply and continue the discussion by visiting your
          course dashboard.
        </p>
      </div>

      <div class="footer">
        <p>
          © <%= new Date().getFullYear() %> YourCoursePlatform. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>
