{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",

    "module": "commonjs",
    "target": "es2020",

    "lib": ["ES2020"],

    "types": ["node"],

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "sourceMap": true,

    "strict": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,

    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },

  "include": ["./**/*"],
  "exclude": ["node_modules", "build"]
}
